# caddy-relay full-featured Caddyfile
# Demonstrates all relay features: STUN/TURN, channels, WebSocket, SSE

{
	# Relay global config: STUN + TURN listeners, channel definitions
	relay {
		stun udp/:3478

		# TURN is off in this shipped config: it needs a long random shared
		# secret (anyone who can reach the port can relay through it) and the
		# public IP to advertise. Generate a secret, set your external IP, then
		# uncomment. turn_tls serves the certificate Caddy automates for the
		# domain below (the example.com site), or a certificate file pair.
		#
		# turn udp/:5349
		# turn_secret change-me-to-a-long-random-string
		# turn_external_ip 203.0.113.1
		# turn_relay_ports 49152-65535
		# turn_max_allocations 1024
		# turn_auth_rate 50
		# turn_tls :5349
		# turn_tls_domain example.com
		# turn_tls_cert /etc/caddy/turn.crt
		# turn_tls_key /etc/caddy/turn.key

		channels {
			max_channels 2000
			max_participants 10000
			max_participants_per_ip 50
			max_memory 256M

			# Pattern-based channel rules
			room-* {
				messages        50
				participants    100
				max_size        64K
				rate_limit      100ms
				idle_ttl        5m
				retain          10m
			}

			lobby {
				messages        10
				participants    500
				max_size        16K
				rate_limit      200ms
				idle_ttl        30s
			}
		}
	}
}

example.com {
	bind :80
	bind :443

	# Route WebSocket upgrade requests
	@ws {
		header Connection "Upgrade"
		header Upgrade "websocket"
	}

	# Route SSE requests
	@sse {
		path /events*
	}

	handle @ws {
		relay_ws {
			subscribe room-*
			publish room-*
			intercept /api/intercept
		}
	}

	handle @sse {
		relay_sse {
			subscribe room-*
			publish room-*
			intercept {
				template {
					{{ message | publish channel }}
				}
			}
		}
	}

	# Static files fallback
	file_server {
		root /srv/www
	}
}