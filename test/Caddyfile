# caddy-relay container end-to-end config.
#
# test/e2e.sh substitutes the {{PLACEHOLDER}} ports and the TURN secret
# (picked from a free block at runtime so the test does not collide with
# whatever else is on the host), mounts the result at
# /srv/www/Caddyfile (the image's working directory, where `caddy run` looks)
# in the image built by ./build.sh, and drives the container over published
# ports:
#
#   - STUN and TURN (UDP) with REST credentials, plus TURN over TLS
#   - channel limits: max_channels, max_participants, max_participants_per_ip,
#     max_memory, and rules
#   - TURN limits: turn_max_allocations and turn_auth_rate
#   - relay_ws with a template intercept and an origin allow-list
#   - relay_sse with a URL intercept that posts back to this same server
#   - an HTTPS site (Caddy's internal CA) serving wss
#
# Sites bind all interfaces: the script reaches them through Docker's published
# ports, and a listener on 127.0.0.1 inside the container would not be
# reachable that way. Host and container ports are the same, because the
# relative intercept path posts back to the request's own Host.
# The admin endpoint keeps its default address so the image's HEALTHCHECK,
# which the script waits on, keeps working.

{
	relay {
		stun udp/:{{STUN_PORT}}

		turn udp/:{{TURN_PORT}}
		turn_secret {{TURN_SECRET}}
		turn_external_ip 127.0.0.1
		# Relays bind every interface so the published relay ports work, while
		# clients are told to dial 127.0.0.1.
		turn_bind 0.0.0.0
		turn_relay_ports {{RELAY_MIN}}-{{RELAY_MAX}}
		# TURN limits: one allocation per five-tuple is pion's own rule, so a
		# small global cap still allows the suite's single allocation.
		turn_max_allocations 8
		turn_auth_rate 100

		# Peers allowed to report the client in X-Forwarded-For. The protocol
		# client shares this container's network namespace, so it appears as
		# 127.0.0.1, while a request through Docker's published ports appears
		# as the bridge address and is not trusted.
		trusted_proxies 127.0.0.1/32

		# TURN over TLS serves the certificate Caddy already manages for
		# localhost (the HTTPS site below uses `tls internal`), so no
		# certificate files are mounted.
		turn_tls :{{TURN_TLS_PORT}}
		turn_tls_domain localhost

		channels {
			max_channels 100
			max_participants 1000
			max_participants_per_ip 100
			max_memory 64M

			room-* {
				messages     10
				participants 100
				max_size     64K
				rate_limit   10ms
				idle_ttl     1m
				retain       1m
			}

			lobby {
				messages     5
				participants 50
				max_size     4K
				rate_limit   10ms
				idle_ttl     30s
			}

			ip-* {
				messages     5
				participants 10
				rate_limit   10ms
				idle_ttl     30s
			}
		}
	}
}

http://:{{HTTP_PORT}} {
	# WebSocket relay: template intercept, origin allow-list.
	handle /ws/* {
		relay_ws {
			subscribe room-*
			publish room-*
			origins 127.0.0.1
			intercept {
				template {
					{{ message }}
				}
			}
		}
	}

	# SSE relay: every message goes through the URL intercept below, which
	# posts back to this same server (a relative intercept path).
	handle /events/* {
		relay_sse {
			subscribe room-*
			publish room-*
			intercept /intercept/url
		}
	}

	# The URL intercept target. Its response replaces the message body.
	handle /intercept/url {
		respond `{"intercepted":true}`
	}

	# The client host as the relay sees it: a trusted X-Forwarded-For is
	# honored, so the protocol client can assert the forwarded address, and a
	# header sent through the published ports is ignored.
	handle /ip/* {
		relay_sse {
			subscribe ip-*
			publish ip-*
			intercept {
				template {
					{{ remote_ip }}
				}
			}
		}
	}

	# Browser fixtures: a real browser drives WebSocket and EventSource.
	# test/e2e.sh mounts test/browser here when the browser check is enabled.
	handle_path /browser/* {
		root * /srv/browser
		file_server
	}

	# Readiness probe for the test.
	handle {
		respond "caddy-relay e2e"
	}
}

https://localhost:{{HTTPS_PORT}} {
	bind 0.0.0.0
	tls internal

	handle /ws/* {
		relay_ws {
			subscribe room-*
			publish room-*
		}
	}
}
